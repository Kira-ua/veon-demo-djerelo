---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Situations from "../components/Situations.astro";
import Prices from "../components/Prices.astro";
import Conditions from "../components/Conditions.astro";
import Team from "../components/Team.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import BottomBar from "../components/BottomBar.astro";
import { main, email, socials } from "../data/site";

const title = "Реабілітаційний центр з проживанням в Одесі | Джерело Life";
const description = "Реабілітація після інсульту, травм і операцій з проживанням в Одесі. Догляд 24/7, хоспіс. Ціни від 2500 грн/доба. Приймаємо з Миколаєва.";

// JSON-LD MedicalClinic: facts from client.json only; no rating (C-024 has no source).
const ld = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Джерело Life",
  telephone: main.tel,
  email,
  address: { "@type": "PostalAddress", streetAddress: "вул. Абрикосова, 1/2", addressLocality: "Одеса", addressCountry: "UA" },
  sameAs: socials.map((s) => s.href),
  availableService: [
    "Реабілітація після інсульту",
    "Реабілітація після травм і переломів",
    "Реабілітація після операцій і ендопротезування",
    "Реабілітація після інфаркту та COVID-19",
    "Догляд 24/7 за літніми людьми",
    "Хоспіс і паліативна допомога",
  ].map((name) => ({ "@type": "MedicalTherapy", name })),
};
---
<Base lang="uk" title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Header slot="header" />
  <Hero />
  <Situations />
  <Prices />
  <Conditions />
  <Team />
  <Contacts />
  <Footer slot="footer" />
  <BottomBar slot="footer" />
</Base>
